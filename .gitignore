_private/
test/evidence/
logs/
*.log
*.pcap
*.pcapng

# Secrets / local config (there should be none).
.env
.env.*
*.local
.npmrc

# Built add-ons: built on macOS and Windows at release time and shipped in the npm package, not committed.
prebuilds/
